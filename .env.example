# Next.js Frontend Environment Variables

# Next.js App URL (for the frontend application)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node.js API Server URL (URL where the backend API server is running)
NODE_API_URL=http://localhost:3001

# Google Gemini API Key (for AI-powered insights and chat features)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here
